VITE_API_BASE_URL=http://localhost:3021/api

# v3.7: kalau dashboard ini diakses lewat IP LAN kantor (bukan localhost
# di laptop yang sama dengan Docker), GANTI baris di atas jadi:
#   VITE_API_BASE_URL=http://<IP-LAN-server-ini>:3021/api
# (harus IP yang sama dengan LAN_BIND_HOST di .env root). PENTING: nilai
# ini "dipanggang" (baked-in) ke hasil build React saat `docker compose
# build`/`up --build` -- kalau nilainya diubah belakangan, WAJIB rebuild
# ulang service frontend (`docker compose up -d --build frontend`), buka
# browser saja tidak cukup.
#
# PENTING -- SALAH UMUM: JANGAN isi baris di atas dengan domain dashboard
# (mis. http://csc-center.gs.astra.co.id/api). Backend jalan di PORT
# TERPISAH (3021) dari dashboard (5193/80), dan tidak ada proxy /api di
# depan domain itu -- kalau dipaksa pakai domain, semua request ke
# backend bakal 404. SELALU pakai <IP-LAN-server-ini>:3021/api, walaupun
# dashboard-nya sendiri dibuka lewat domain di browser.

# v3.8: WAJIB diisi kalau dashboard dibuka lewat DOMAIN di browser (bukan
# cuma IP:port langsung) -- Vite 5 menolak request dengan Host header
# yang tidak dikenal (proteksi bawaan DNS rebinding), gejalanya 403/blank
# saat diakses lewat domain padahal lewat IP:port normal. Isi HANYA
# hostname-nya (TANPA http/https, TANPA port), boleh lebih dari satu
# dipisah koma, contoh:
#   VITE_ALLOWED_HOST=csc-center.gs.astra.co.id
VITE_ALLOWED_HOST=

# Harus SAMA PERSIS dengan BACKEND_API_KEY di csc-backend/.env, kalau
# backend sudah diaktifkan proteksi API key-nya. Nilai ini nempel di
# hasil build frontend (bisa dilihat siapa saja lewat browser dev tools),
# jadi ini bukan "rahasia" -- fungsinya cuma nyaring bot/scanner acak,
# BUKAN pengganti login/autentikasi user.
VITE_API_KEY=
