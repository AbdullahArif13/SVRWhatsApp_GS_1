PORT=3001

# Kunci rahasia buat autentikasi endpoint /api/* (dicek lewat header
# X-API-Key). WAJIB diisi dengan string acak yang panjang & unik.
# Generate contoh: openssl rand -hex 32
#
# PENTING: kalau ini kosong, server TIDAK AKAN START (fail-closed) --
# lihat ALLOW_UNAUTHENTICATED_DEV di bawah kalau butuh bypass sementara
# untuk development lokal.
BACKEND_API_KEY=

# HANYA untuk development lokal: set "true" untuk mengizinkan server
# start TANPA BACKEND_API_KEY (endpoint /api/* jadi tidak terlindungi
# sama sekali). JANGAN PERNAH set ini di staging/production. Biarkan
# kosong/tidak diisi di semua environment selain laptop dev kamu sendiri.
ALLOW_UNAUTHENTICATED_DEV=

# Kunci API KEDUA yang terpisah dari BACKEND_API_KEY di atas, khusus
# untuk integrasi server-to-server (sistem eksternal yang manggil
# backend ini langsung, BUKAN lewat dashboard/browser). Punya akses
# yang sama persis dengan BACKEND_API_KEY ke semua endpoint /api/*,
# tapi dipisah supaya bisa di-revoke/diganti sendiri-sendiri tanpa
# mempengaruhi dashboard.
#
# INI RAHASIA BENERAN (beda dengan BACKEND_API_KEY dashboard yang
# nempel di build frontend) -- taruh HANYA di konfigurasi/secret store
# sistem pemanggil, JANGAN PERNAH di kode yang jalan di browser.
# Generate contoh: openssl rand -hex 32
#
# Opsional -- kosongkan kalau belum ada integrasi server-to-server.
SYSTEM_API_KEY=

# v3.10: login dashboard (Admin, username+password, lihat
# controllers/authController.js). Dipakai express-session untuk
# menandatangani cookie sesi login -- BEDA dan TERPISAH dari
# BACKEND_API_KEY/SYSTEM_API_KEY di atas.
#
# WAJIB diisi string acak & panjang, sama seperti BACKEND_API_KEY --
# server TIDAK AKAN START (fail-closed) kalau ini kosong.
# Generate contoh: openssl rand -base64 32
SESSION_SECRET=

# Origin (URL) frontend yang diizinkan manggil API ini lewat CORS.
# Pisahkan dengan koma kalau lebih dari satu, contoh:
# CORS_ORIGIN=http://localhost:5193,https://dashboard.perusahaan.com
CORS_ORIGIN=http://localhost:5193

# GOWA (go-whatsapp-web-multidevice) - https://github.com/aldinokemal/go-whatsapp-web-multidevice
#
# CATATAN: kalau backend ini dijalankan lewat `docker compose up` (root
# project), nilai ini OTOMATIS di-override jadi "http://whatsapp:3000"
# (nama service di docker-compose.yml), jadi tidak perlu diubah manual.
# Nilai di bawah ini cuma dipakai kalau kamu jalankan backend LANGSUNG di
# host (npm run dev, tanpa Docker) sambil GOWA jalan lokal di port 3000.
GOWA_BASE_URL=http://localhost:3000

# Isi HANYA kalau GOWA kamu dijalankan dengan --basic-auth=user:pass
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASS=

# Isi HANYA kalau GOWA kamu setup multi-device dan device yang mau dipakai
# bukan device default/satu-satunya. Kalau cuma 1 device yang login, kosongkan saja.
GOWA_DEVICE_ID=

# v3.4: pengaturan ANTRIAN pengiriman (lihat services/queueService.js).
# QUEUE_RATE_LIMIT_PER_MINUTE -- maksimal berapa pesan/menit yang BENERAN
#   dikirim ke GOWA, berapa pun banyaknya request yang masuk ke
#   POST /send-message. Kosongkan untuk pakai default (30).
QUEUE_RATE_LIMIT_PER_MINUTE=30
# QUEUE_MAX_LENGTH -- batas jaga-jaga jumlah pesan yang boleh menumpuk di
#   antrian sekaligus (bukan throttle normal, cuma anti-DoS). Kosongkan
#   untuk pakai default (10000).
QUEUE_MAX_LENGTH=10000
# ENQUEUE_RATE_LIMIT_PER_MINUTE -- rate limit di sisi PENERIMAAN request
#   POST /send-message per IP (beda dari QUEUE_RATE_LIMIT_PER_MINUTE di
#   atas yang ngatur sisi PENGIRIMAN ke GOWA). Sengaja jauh lebih longgar
#   karena endpoint ini memang dirancang menerima lonjakan (ribuan
#   request sekaligus). Kosongkan untuk pakai default (2000).
ENQUEUE_RATE_LIMIT_PER_MINUTE=2000

# v3.9: pengerasan pola kirim supaya tidak gampang dibedakan dari "bot"
# oleh sistem deteksi WhatsApp (lihat komentar lengkap di queueService.js).
# Semua opsional -- kosongkan untuk pakai default.
#
# SEND_JITTER_MIN_MS/MAX_MS -- delay acak tambahan (ms) sebelum TIAP
#   pengiriman, supaya jarak antar pesan tidak identik persis. Default
#   300-1500.
SEND_JITTER_MIN_MS=300
SEND_JITTER_MAX_MS=1500
# SEND_COOLDOWN_PER_NUMBER_MS -- jeda minimal (ms) sebelum mengirim LAGI ke
#   nomor yang SAMA (mencegah pola "spam ke satu nomor" kalau ada bug
#   retry di sistem eksternal). Default 60000 (60 detik). TIDAK berlaku
#   untuk balasan otomatis Approve/Reject.
SEND_COOLDOWN_PER_NUMBER_MS=60000
# CIRCUIT_FAILURE_THRESHOLD -- berapa kali gagal kirim BERTURUT-TURUT
#   sebelum semua pengiriman baru otomatis dijeda sementara (circuit
#   breaker). Default 5.
CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_COOLDOWN_MS -- berapa lama (ms) jeda circuit breaker di atas
#   sebelum otomatis dicoba lagi. Default 180000 (3 menit).
CIRCUIT_COOLDOWN_MS=180000

# v3.2: fitur Approve/Reject -- webhook dari GOWA (pesan masuk / balasan
# user) diverifikasi pakai HMAC SHA256 (header X-Hub-Signature-256).
# WAJIB SAMA PERSIS dengan --webhook-secret / WHATSAPP_WEBHOOK_SECRET yang
# dipakai di service "whatsapp" (lihat docker-compose.yml root project).
# Kalau dikosongkan, verifikasi signature DILEWATI (cuma buat coba-coba
# lokal) -- WARNING akan tercetak di log tiap ada webhook masuk.
WHATSAPP_WEBHOOK_SECRET=

# PostgreSQL. Sama seperti GOWA_BASE_URL di atas: kalau dijalankan lewat
# `docker compose up`, DB_HOST otomatis di-override jadi "postgres" (nama
# service). Nilai 127.0.0.1 di bawah ini cuma dipakai kalau backend
# dijalankan langsung di host tanpa Docker.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=csc_user
DB_PASSWORD=csc_password
DB_NAME=csc_dashboard
