# .env INI DIBACA OTOMATIS OLEH docker-compose.yml (harus di folder yang
# sama). Copy jadi ".env" lalu ganti SEMUA password di bawah dengan yang
# acak & kuat sebelum dipentest / dipakai di luar laptop kamu sendiri.
#
# Generate password acak, contoh:
#   openssl rand -base64 24

POSTGRES_DB=csc_dashboard
POSTGRES_USER=csc_user
POSTGRES_PASSWORD=ganti_dengan_password_acak_yang_kuat

# Kunci API backend (X-API-Key) untuk dashboard. Harus SAMA PERSIS dengan
# BACKEND_API_KEY di csc-backend/.env dan VITE_API_KEY di csc-dashboard/.env.
BACKEND_API_KEY=ganti_dengan_string_acak_yang_panjang

# Kunci API KEDUA, khusus integrasi server-to-server (sistem eksternal
# yang manggil backend ini langsung, BUKAN lewat dashboard/browser).
# Terpisah dari BACKEND_API_KEY di atas supaya bisa di-revoke sendiri
# tanpa mempengaruhi dashboard. Simpan HANYA di sisi sistem pemanggil
# (server), JANGAN PERNAH ditaruh di kode yang jalan di browser.
# Opsional -- kosongkan kalau belum ada integrasi ini.
SYSTEM_API_KEY=ganti_dengan_string_acak_yang_panjang_beda_dari_backend_api_key

# v3.2: fitur Approve/Reject. Dipakai GOWA (service "whatsapp" di bawah)
# untuk menandatangani (HMAC SHA256) setiap webhook yang dikirim ke
# backend, dan dipakai backend (csc-backend/.env, key WHATSAPP_WEBHOOK_SECRET)
# untuk memverifikasinya -- HARUS SAMA PERSIS di kedua tempat.
WHATSAPP_WEBHOOK_SECRET=ganti_dengan_string_acak_yang_panjang

# v3.7: opsional -- HANYA isi kalau backend & dashboard perlu diakses
# LANGSUNG lewat jaringan LAN kantor/perusahaan (bukan dari laptop yang
# sama dengan Docker-nya, dan bukan lewat SSH tunnel/VPN). Lihat
# penjelasan lengkap "MODE A vs MODE B" di komentar atas docker-compose.yml.
#
# LAN_BIND_HOST -- isi IP INTERNAL server ini (BUKAN 0.0.0.0, biar tidak
#   ikut ke-expose kalau server ini kebetulan juga punya IP publik),
#   contoh: LAN_BIND_HOST=10.20.30.40
#   Kosongkan (biarkan baris ini di-comment/tidak ada) untuk tetap
#   localhost-only (default, paling aman -- akses lewat SSH tunnel/VPN).
# LAN_FRONTEND_ORIGIN -- URL lengkap dashboard yang bakal dibuka user
#   lewat browser, dipakai backend buat validasi CORS. HARUS pakai IP/host
#   & port YANG SAMA dengan LAN_BIND_HOST di atas, contoh:
#   LAN_FRONTEND_ORIGIN=http://10.20.30.40:5193
#
LAN_BIND_HOST=
LAN_FRONTEND_ORIGIN=
